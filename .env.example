# Copie para .env.local ou execute npm run setup. Nunca versionar segredos.
SERP_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
SERPER_API_KEY=

# Google Ads: somente leitura. IDs sem hifens.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Alternativa para sua conta de pesquisa (usada quando CUSTOMER_ID está vazio):
GOOGLE_ADS_RESEARCH_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v24

# Google Search Console: consentimento Google separado, escopo webmasters.readonly.
# Ative a Search Console API no Google Cloud. Não reutilize o refresh token Ads.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
# Copie o identificador exato da propriedade. Ex.: sc-domain:adalbapro.com.br
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Opcional: propriedades exatas permitidas, separadas por vírgulas.
GOOGLE_SEARCH_CONSOLE_ALLOWED_SITES=

# Token próprio deste MCP, diferente das chaves dos provedores.
MCP_AUTH_TOKEN=
MCP_AUTH_MODE=bearer
MCP_PUBLIC_URL=http://localhost:3000
# Na Vercel, use sua origem HTTPS pública. Omitir permite detecção pelo deploy.
# Não copie o valor localhost para o ambiente Production.
# Origens adicionais separadas por vírgulas. Não aceita wildcard.
MCP_ALLOWED_ORIGINS=

# Para ChatGPT remoto: HTTPS público + OAuth em um servidor compatível.
# Use oauth (somente OAuth) ou both (OAuth e token Bearer).
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_SCOPES=research:read
# Opcional: restringir a sujeitos específicos, separados por vírgulas.
MCP_OAUTH_ALLOWED_SUBJECTS=
