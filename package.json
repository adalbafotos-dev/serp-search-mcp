{
  "name": "serp-search-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP de pesquisa web, Google Ads e estratégia de conteúdo",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:hosted": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "verify": "tsx scripts/verify.ts",
    "setup": "node scripts/setup.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@next/env": "~16.4.0",
    "cheerio": "^1.1.2",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "next": "~16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "engines": { "node": ">=22.0.0" }
}
